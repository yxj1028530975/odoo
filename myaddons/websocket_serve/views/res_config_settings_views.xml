<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="res_config_settings_view_form" model="ir.ui.view">
            <field name="name">res.config.settings.view.form.inherit.websocket</field>
            <field name="model">res.config.settings</field>
            <field name="priority" eval="75"/>
            <field name="inherit_id" ref="base.res_config_settings_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//form" position="inside">
                    <app data-string="websocket" string="websocket" name="websocket">
                        <block title="websocket API" name="websocket_api_config">
                            <setting id="websocket_host_setting" string="websocket  Host" help="websocket service Host">
                                <field name="websocket_host"/>
                            </setting>
                            <setting id="websocket_port_setting" string="websocket Port" help="websocket service PORT">
                                <field name="websocket_port"/>
                            </setting>
                            <setting id="websocket_ping_interval_setting" string="websocket Port" help="websocket service PORT">
                                <field name="websocket_ping_interval"/>
                            </setting>
                            <setting id="websocket_ping_timeout_setting" string="websocket ping_timeout" help="websocket service ping_timeout">
                                <field name="websocket_ping_timeout"/>
                            </setting>
                        </block>
                    </app>
                </xpath>
            </field>
        </record>

        <record id="action_websocket_configuration" model="ir.actions.act_window">
            <field name="name">Settings</field>
            <field name="res_model">res.config.settings</field>
            <field name="view_mode">form</field>
            <field name="target">inline</field>
            <field name="context">{"module":"websocket"}</field>
        </record>
    </data>
</odoo>
