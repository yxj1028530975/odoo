<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_wechat_account_tree" model="ir.ui.view">
            <field name="name">wechat.account.tree</field>
            <field name="model">wechat.account</field>
            <field name="arch" type="xml">
                <tree string="Wechat Account">
                    <!-- <header>
                        <button name="send_client_message" type="object" string="消息通信"/>
                    </header> -->
                    <field name="name"/>
                    <field name="wechat_account_port"/>
                    <field name="wechat_process_id"/>
                    <field name="websocket_client_id"/>
                    <field name="wechat_states" widget="badge" decoration-danger="wechat_states == 'offline'" decoration-success="wechat_states == 'online'"/>
                </tree>
            </field>
        </record>

        <record id="view_wechat_account_form" model="ir.ui.view">
            <field name="name">wechat.account.form</field>
            <field name="model">wechat.account</field>
            <field name="arch" type="xml">
                <form string="Wechat Account">
                    <sheet>
                        <header>
                            <field name="wechat_states" widget="statusbar" statusbar_visible="offline,online" decoration-danger="wechat_states == 'offline'" decoration-success="wechat_states == 'online'" clickable="0"/> 
                        </header>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="wechat_account_port"/>
                                <field name="wechat_process_id"/>
                                <field name="websocket_client_id"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        
        <record id="action_wechat_account" model="ir.actions.act_window">
            <field name="name">Wechat Account</field>
            <field name="res_model">wechat.account</field>
            <field name="view_mode">tree,form</field>
        </record>


    </data>
</odoo>
